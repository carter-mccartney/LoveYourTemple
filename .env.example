# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Leave unset to run in local (this-browser-only) mode.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
# Optional: lets crew notifications arrive while the app is closed (see supabase/functions/notify-crew).
VITE_VAPID_PUBLIC_KEY=
